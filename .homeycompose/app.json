    "nl": "Neem beslissingen in je Flows met je eigen context."
  },
  "category": [
    "tools"
  ],
  "brandColor": "#E351B9",
  "permissions": [],
  "author": {
    "name": "Bas Milius",
    "email": "bas@mili.us"
  },
  "source": "https://github.com/basmilius/homey-jev",
  "bugs": {
    "url": "https://github.com/basmilius/homey-jev/issues"
  },
  "api": {
    "getSettings": {
      "method": "GET",
      "path": "/settings"
